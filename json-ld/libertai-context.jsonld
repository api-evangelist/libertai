{
  "@context": {
    "@vocab": "https://libertai.io/schema#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "libertai": "https://libertai.io/schema#",
    "AlephCreditsRequest": "libertai:AlephCreditsRequest",
    "address": {
      "@id": "libertai:address",
      "@type": "xsd:string"
    },
    "amount": {
      "@id": "libertai:amount",
      "@type": "xsd:decimal"
    },
    "HTTPValidationError": "libertai:HTTPValidationError",
    "detail": {
      "@id": "libertai:detail",
      "@container": "@list"
    },
    "ProxyRequest": "libertai:ProxyRequest",
    "model": {
      "@id": "libertai:model",
      "@type": "xsd:string"
    },
    "ValidationError": "libertai:ValidationError",
    "loc": {
      "@id": "libertai:loc",
      "@container": "@list"
    },
    "msg": {
      "@id": "libertai:msg",
      "@type": "xsd:string"
    },
    "type": {
      "@id": "libertai:type",
      "@type": "xsd:string"
    }
  },
  "@type": "schema:Dataset",
  "schema:name": "LibertAI API JSON-LD context",
  "schema:description": "A JSON-LD @context for the objects LibertAI's own API contract declares: one class per component schema, one property per declared field, typed from the contract. Derived by script (derive-json-ld.py, 2026-10-13) from openapi/libertai-openapi.yml.",
  "dcterms:created": "2026-10-13",
  "dcterms:source": [
    "openapi/libertai-openapi.yml"
  ]
}